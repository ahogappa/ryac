#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'
require 'fileutils'
require_relative '../lib/ryac'

options = {
  output: nil,
  aliases: nil,
  level: nil,
  gems: nil,
  pack: nil,
  driver: nil,
  split: nil
}

parser = OptionParser.new do |opts|
  opts.banner = "Usage: minify [options] [FILE...]"

  opts.on("-o", "--output FILE", "Write output to FILE instead of stdout") do |file|
    options[:output] = file
  end

  opts.on("-a", "--aliases FILE", "Write constant alias declarations to FILE") do |file|
    options[:aliases] = file
  end

  opts.on("-g", "--gem GEM_NAMES", "Minify installed gem(s) by name (comma-separated)") do |names|
    options[:gems] = names.split(',').map(&:strip).reject(&:empty?)
  end

  opts.on("-c", "--compress LEVEL", "Set compression level (stable or unstable)") do |value|
    begin
      options[:level] = Ryac::Minifier.resolve_level(value)
    rescue ArgumentError => e
      warn "Error: #{e.message}"
      warn opts
      exit 1
    end
  end

  opts.on("-p", "--pack FORMAT", "Emit a self-extracting file (self or zlib)") do |value|
    begin
      options[:pack] = Ryac::Packer.resolve_format(value)
    rescue ArgumentError => e
      warn "Error: #{e.message}"
      warn opts
      exit 1
    end
  end

  opts.on("-d", "--driver FILE", "Keep the program a library and write its driver to FILE (ruby FILE CORE --exec EXPR)") do |file|
    options[:driver] = file
  end

  opts.on("-s", "--split DIR", "Write the program back as files under DIR, minified together") do |dir|
    options[:split] = dir
  end

  opts.on("-h", "--help", "Display this help message") do
    puts opts
    exit 0
  end

  opts.on("-v", "--version", "Display version") do
    puts "ryac version #{Ryac::VERSION}"
    exit 0
  end
end

begin
  parser.parse!
rescue OptionParser::InvalidOption => e
  warn "Error: #{e.message}"
  warn parser
  exit 1
end

if options[:split]
  taken = { output: '-o', aliases: '-a', pack: '--pack', driver: '--driver' }.find { |key, _| options[key] }
  if taken
    warn "Error: --split cannot be combined with #{taken[1]} (the split layout writes the whole program under DIR)"
    exit 1
  end
end

if options[:driver]
  unless options[:output]
    warn "Error: --driver needs -o for the core file"
    exit 1
  end
  if options[:aliases]
    warn "Error: --driver cannot be combined with -a (the runner loads the core with its aliases)"
    exit 1
  end
  if options[:pack]
    warn "Error: --driver cannot be combined with --pack (a packed core cannot be loaded)"
    exit 1
  end
end

if options[:gems]
  unless ARGV.empty?
    warn "Error: Cannot specify both --gem and file arguments"
    exit 1
  end

  if options[:gems].empty?
    warn "Error: No gem names specified"
    exit 1
  end

  begin
    gem_args = Ryac::GemResolver.minifier_args(options[:gems])
    entry = gem_args[:entry]
    project_root = gem_args[:project_root]
    gem_require_paths = gem_args[:gem_require_paths]
  rescue Ryac::Pipeline::GemNotFoundError => e
    warn "Error: #{e.message}"
    exit 1
  end
else
  if ARGV.empty?
    warn "Error: No entry file specified"
    warn parser
    exit 1
  end

  ARGV.each do |file|
    unless File.exist?(file)
      warn "Error: File not found: #{file}"
      exit 1
    end
  end

  entry = ARGV.size == 1 ? ARGV[0] : ARGV.dup
  project_root = nil
  gem_require_paths = []
end

gem_names = options[:gems] || []

begin
  minifier = Ryac::Minifier.new
  level_opts = options[:level] ? { level: options[:level] } : {}
  source_opts = { project_root: project_root, gem_names: gem_names, gem_require_paths: gem_require_paths }

  if options[:split]
    result = minifier.split(entry, **level_opts, **source_opts)
    result.files.each do |path, text|
      target = File.join(options[:split], path)
      FileUtils.mkdir_p(File.dirname(target))
      File.binwrite(target, text)
    end
  else
    result = minifier.call(entry, **level_opts, **source_opts, driver: !options[:driver].nil?)

    content = if options[:aliases]
      File.write(options[:aliases], result.aliases)
      result.content
    else
      result.full_content
    end

    content = Ryac::Packer.pack(content, options[:pack]) if options[:pack]

    File.write(options[:driver], Ryac::DriverFile::SOURCE) if options[:driver]

    if options[:output]
      File.binwrite(options[:output], content)
    else
      $stdout.binmode if options[:pack]
      puts content
    end
  end

  warn "Compression: #{((1 - result.stats.compression_ratio) * 100).round(1)}%"
  warn "Files processed: #{result.stats.file_count}"
rescue Ryac::SyntaxError => e
  warn "Error: the input does not parse"
  warn "  #{e.message}"
  exit 2
rescue Ryac::InputError => e
  warn "Error: #{e.message}"
  exit 2
rescue Ryac::InternalError => e
  warn "Error: this is a bug in ryac, not in your program — please report it"
  warn "  #{e.message}"
  exit 3
rescue => e
  warn "Error: this is a bug in ryac, not in your program — please report it"
  warn "  #{e.class}: #{e.message}"
  exit 3
end
