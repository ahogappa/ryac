module RubyMinify
  VERSION: String

  class Error < StandardError
  end

  class MinifyError < Error
  end

  class SyntaxError < Error
  end

  type tp_node = TypeProf::Core::AST::Node
  type tp_genv = TypeProf::Core::GlobalEnv
  type location_key = [Integer, Integer]
  type scope_id = location_key
  type scope_mapping_table = Hash[scope_id, Hash[Symbol, String]]
  type syntax_value = String | Integer | Symbol | bool | Hash[Symbol, String] | nil
  type syntax_data_map = Hash[[Integer, Integer], Hash[Symbol, syntax_value]]
  type meta_node_entry = { type: Symbol, args: Array[Symbol] }

  # --- scope_management.rb ---
  module RenameInvariants
    def verify_injective!: (Hash[Symbol, String] mapping, String scope_label) -> void
  end

  include RenameInvariants

  # --- analysis/method/collection.rb ---
  def collect_method_definitions: (Prism::Node prism_root) -> void
  def resolve_method_calls: () -> void
  def scan_dynamic_method_references: (Prism::Node prism_root) -> void
  def collect_visibility_modifier_methods: (Prism::Node prism_root) -> void
  def collect_alias_undef_methods: (Prism::Node prism_root) -> void

  DYNAMIC_DISPATCH_METHODS: Array[Symbol]
  VISIBILITY_MODIFIERS: Array[Symbol]
  UNRESOLVED_CALL_NODES: Array[Class]

  private

  def link_module_function_variant: (Prism::DefNode def_node, Array[Symbol] cpath, bool singleton, Symbol mid, method_key method_key) -> void
  def resolve_def_receiver_cpath: (Prism::Node? receiver) -> Array[Symbol]?
  def build_cpath_from_prism_node: (Prism::Node node) -> Array[Symbol]?
  def merge_super_groups: (Array[[method_key, method_key]] super_merges) -> void
  def merge_polymorphic_groups: (Hash[location_key, Array[method_key]] call_node_to_keys) -> void
  def merge_unresolved_calls: (Set[location_key] resolved_call_keys) -> void
  def classify_unresolved_call: (Symbol mid, Prism::Node node) -> Symbol

  public

  # --- analysis/constant/collection.rb ---
  def each_constant_event: (Prism::Node prism_root) { (Symbol, Prism::Node, Array[Symbol]?, bool, bool) -> void } -> void
  def class_definition_cpath: (Prism::ClassNode | Prism::ModuleNode node, Array[Symbol] nesting) -> Array[Symbol]?
  def qualified_write_cpath: (Prism::Node target, Array[Symbol] nesting, ?strip_doubled_nesting: bool) -> Array[Symbol]?
  def syntactic_const_segments: (Prism::Node node) -> Array[Symbol]
  def struct_definition_write?: (Prism::Node node) -> bool
  def collect_constants: (Prism::Node prism_root) -> void
  def exclude_private_constants: (Prism::Node prism_root) -> void
  def count_constant_references: (Prism::Node prism_root) -> void
  def increment_constant_read_usage: (Prism::Node node) -> void
  def resolve_user_defined_cpath: (Prism::Node node) -> Array[Symbol]?
  def resolve_superclass_path: (Prism::Node superclass_node, Array[Symbol] class_cpath) -> Array[Symbol]?
  def augment_constant_counts_via_oracle: () -> void
  def collect_external_references: (Prism::Node prism_root) -> void
  def mark_chain_prefixes: (Prism::Node node, Set[Integer] counted_prefix_ids) -> void
  def external_prefix_for: (Prism::Node node) -> Array[Symbol]?
  def complete_const_chain?: (Prism::Node node) -> bool
  def required_external_root?: (Symbol root) -> bool
  def external_require_roots: (Array[String] stdlib_requires) -> Set[String]

  # --- analysis/ivar/collection.rb ---
  DYNAMIC_IVAR_METHODS: Array[Symbol]
  ATTR_DECLARATION_METHODS: Array[Symbol]
  IVAR_WRITE_NODES: Array[Class]

  def collect_ivar_definitions: (Prism::Node prism_root, Hash[Array[Symbol], Set[Symbol]] attr_backed) -> void
  def collect_attr_backed_ivars: (Prism::Node prism_root) -> Hash[Array[Symbol], Set[Symbol]]
  def scan_dynamic_ivar_access: (Prism::Node prism_root) -> void
  def merge_inherited_ivars: () -> void
  def reserve_attr_ivar_names: (Prism::Node prism_root) -> void
  def coordinate_attr_renames: (Prism::Node prism_root, Hash[location_key, String] rename_map, Hash[location_key, String] attr_ivar_entries) -> Hash[location_key, Hash[Symbol, String]]

  # --- analysis/keyword/collection.rb ---
  def collect_keyword_info: (Prism::Node prism_root) -> void

  private

  def each_attr_declaration: (Prism::Node prism_root, Array[Symbol] methods, ?require_class_body: bool) { (Prism::CallNode, Array[Symbol], bool, Symbol) -> void } -> void
  def def_keyword_names: (Prism::DefNode def_node) -> Array[Symbol]
  def def_keyword_rest?: (Prism::DefNode def_node) -> bool
  def collect_keyword_call_sites: (Prism::Node prism_root) -> void
  def forwards_parameters_to_super?: (Prism::DefNode def_node) -> bool
  def exclude_unresolved_keyword_calls: (Prism::Node prism_root) -> void
  def carries_keyword_arguments?: (Prism::CallNode call_node) -> bool

  public

  # --- analysis/cvar/collection.rb ---
  DYNAMIC_CVAR_METHODS: Array[Symbol]
  CVAR_WRITE_NODES: Array[Class]

  def collect_cvar_definitions: (Prism::Node prism_root) -> void
  def scan_dynamic_cvar_access: (Prism::Node prism_root) -> void
  def merge_inherited_cvars: () -> void

  # --- analysis/gvar/collection.rb ---
  GVAR_NODES: Array[Class]

  def collect_gvar_definitions: (Prism::Node prism_root) -> void
  def scan_alias_globals: (Prism::Node prism_root) -> void

  # --- analysis/method_aliases.rb ---
  METHOD_ALIASES: Hash[Symbol, Symbol]
  METHOD_TRANSFORMS: Hash[[Symbol, Symbol], String]

  # --- analysis/method_aliasing.rb ---
  def resolve_method_aliases_and_transforms: (Prism::Node prism_root) -> [Hash[location_key, Symbol], Hash[location_key, String]]
end
