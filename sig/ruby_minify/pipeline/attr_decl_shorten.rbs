module RubyMinify
  module Pipeline
    class AttrDeclShorten
      include RenamePatcher

      def self.collect_patches_from: (Prism::Node prism_ast, Array[patch_entry] patches, AnalysisResult analysis, ?Hash[Symbol, untyped]? kwargs) -> void
      def self.postprocess: (String result, AnalysisResult _analysis, String aliases_str, String preamble_str) -> [String, String, String]
      def collect: (Prism::Node node, Array[patch_entry] patches, AnalysisResult analysis, ?rename_attrs: bool?) -> void

      private

      def render_attr_declaration: (Symbol type, Array[String] names) -> String?
    end
  end
end
