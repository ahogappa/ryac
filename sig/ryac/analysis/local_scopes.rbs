module Ryac
  class LocalScopes
    include RenameInvariants

    DYNAMIC_VARIABLE_METHODS: Array[Symbol]
    NUMBERED_PARAM_RE: Regexp
    VARIABLE_NODES: Array[Class]

    type prism_scope_node = Prism::ProgramNode | Prism::DefNode | Prism::ClassNode
                          | Prism::ModuleNode | Prism::SingletonClassNode
                          | Prism::BlockNode | Prism::LambdaNode
    type prism_variable_node = Prism::LocalVariableReadNode | Prism::LocalVariableWriteNode
                             | Prism::LocalVariableTargetNode | Prism::LocalVariableOperatorWriteNode
                             | Prism::LocalVariableOrWriteNode | Prism::LocalVariableAndWriteNode

    # Runtime class is built via Struct.new(..., keyword_init: true).
    class Scope
      def self.new: (?id: scope_id, ?kind: Symbol, ?node: prism_scope_node, ?parent: Scope?, ?owner_call: Prism::CallNode?, ?mapping: Hash[Symbol, String]?) -> Scope

      attr_accessor id: scope_id
      attr_accessor kind: Symbol
      attr_accessor node: prism_scope_node
      attr_accessor parent: Scope?
      attr_accessor owner_call: Prism::CallNode?
      attr_accessor mapping: Hash[Symbol, String]?

      def allocated?: () -> bool
    end

    @program: Prism::ProgramNode
    @scope_by_node: Hash[Integer, Scope]

    attr_reader scopes: Array[Scope]
    attr_reader rename_entries: Hash[location_key, String]
    attr_reader def_param_names: Hash[line_col_key, Hash[Symbol, String]]
    attr_reader block_param_names: Hash[location_key, Hash[Symbol, String]]
    attr_reader for_index_names: Hash[line_col_key, String]

    def initialize: (Prism::ProgramNode program_node) -> void
    def scope_id_at: (Integer offset) -> scope_id?
    def scope_id_of: (Prism::Node node) -> scope_id?
    def allocate: (?kw_def_map: Hash[location_key, Hash[Symbol, String]], ?var_hints: Hash[scope_id, Hash[Symbol, String]]) -> self
    def scope_mappings: () -> scope_mapping_table
    def visible_local_names: () -> Hash[scope_id, Set[String]]
    def resolve: () -> self

    private

    def scope_range: (Scope scope) -> Range[Integer]
    def add_scope: (Symbol kind, prism_scope_node node, Scope? parent, ?owner_call: Prism::CallNode?) -> Scope
    def build: (Prism::Node? node, ?Scope? current, ?owner_call: Prism::CallNode?) -> void
    def allocate_top: (Scope scope) -> void
    def allocate_def: (Scope scope, Hash[location_key, Hash[Symbol, String]] kw_def_map, Hash[scope_id, Hash[Symbol, String]] var_hints) -> void
    def allocate_block: (Scope scope) -> void
    def ancestor_mapping_values: (Scope scope) -> Array[String]
    def scope_constraints: (Prism::Node? body) -> [bool, Set[Symbol]]

    def allocated_name: (Symbol var, bool unsafe, Set[Symbol] pinned, NameGenerator generator) -> String
    def unused_rescue_vars: (Prism::Node? body) -> Set[Symbol]
    def keyword_param_names: (Prism::DefNode def_node) -> Array[Symbol]
    def block_parameters: (Prism::BlockNode block_node) -> Prism::ParametersNode?
    def block_formal_names: (Prism::BlockNode block_node) -> Array[Symbol?]
    def block_multi_targets: (Prism::BlockNode block_node) -> Array[Prism::MultiTargetNode]
    def use_numbered_params?: (Prism::BlockNode block_node, Array[Symbol?] f_args, Array[String] parent_names) -> bool
    def collect_multi_target_names: (Prism::MultiTargetNode multi_target_node) -> Array[Symbol]
    def collect_extra_block_param_names: (Prism::ParametersNode prism_params) -> Array[Symbol]
    def block_has_non_required_params?: (Prism::ParametersNode? params) -> boolish
    def walk_all: (Prism::Node? node) { (Prism::Node) -> void } -> void
    def resolve_walk: (Prism::Node? node, Array[Scope] stack) -> void
    def enter_scope: (Scope scope, Array[Scope] stack) -> void
    def record_variable: (prism_variable_node node, Array[Scope] stack) -> void
    def resolved_name: (Symbol name, Integer depth, Array[Scope] stack) -> String
    def record_def_params: (Prism::DefNode def_node, Scope scope) -> void
    def each_def_param_name: (Prism::ParametersNode params) { (Symbol) -> void } -> void
    def record_block_params: (Prism::BlockNode block_node, Scope scope) -> void
    def record_for_index: (Prism::ForNode for_node, Array[Scope] stack) -> void
  end
end
