module Ryac
  class KeywordRenameMapping
    include UnionFind[method_key]

    type call_entry = { symbol_node: Prism::SymbolNode, val_node: Prism::Node }
    type keyword_method_info = { keywords: Set[Symbol], call_entries: Hash[Symbol, Array[call_entry]], excluded: bool }

    @methods: Hash[method_key, keyword_method_info]
    @node_short_names: Hash[location_key, String]
    # Keyed by each group's union-find root.
    @keyword_maps: Hash[method_key, Hash[Symbol, String]]
    @frozen: bool

    def initialize: () -> void
    def add_keyword_def: (method_key method_key, Symbol keyword_sym) -> void
    def add_keyword_call: (method_key method_key, Symbol keyword_sym, Prism::SymbolNode symbol_node, Prism::Node val_node) -> void
    def exclude_method: (method_key method_key) -> void

    def exclude_methods_by_mid: (Enumerable[Symbol] mids) -> void
    def merge_groups: (method_key key1, method_key key2) -> void
    def each_method_key: () { (method_key) -> void } -> void
    def assign_short_names: () -> void
    def node_mapping: () -> Hash[location_key, String]
    def def_node_mapping: (Hash[method_key, Array[Prism::DefNode]] def_node_registry) -> Hash[location_key, Hash[Symbol, String]]
    def build_variable_hints: () { (Prism::Node) -> scope_id? } -> Hash[scope_id, Hash[Symbol, String]]

    private

    def init_method: (method_key method_key) -> void
  end
end
